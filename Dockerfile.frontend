# Builder stage for Angular application
FROM node:18-alpine AS builder

WORKDIR /app
COPY web/package*.json ./
RUN npm ci

COPY web/ ./
# Build production bundle using the Angular CLI configuration
RUN npm run build -- --configuration production && \
    mkdir -p /app/dist/webapp && \
    if [ -d "/app/dist/sakai-ng/browser" ]; then mv /app/dist/sakai-ng/browser/* /app/dist/webapp/; \
    elif [ -d "/app/dist/sakai-ng" ]; then mv /app/dist/sakai-ng/* /app/dist/webapp/; fi

# Production environment
FROM nginx:alpine

# Copy unified webapp output
COPY --from=builder /app/dist/webapp /usr/share/nginx/html

# Add custom Nginx configuration to route all requests to index.html (SPA routing)
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root   /usr/share/nginx/html; \
    # Adjust root based on exact output if it is nested \
    index  index.html index.htm; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    # Proxy /api requests to gateway \
    location /api/ { \
        proxy_pass http://iusj-gateway-service:8080/api/; \
        proxy_set_header Host $http_host; \
    } \
    location /auth/ { \
        proxy_pass http://iusj-gateway-service:8080/auth/; \
        proxy_set_header Host $http_host; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]