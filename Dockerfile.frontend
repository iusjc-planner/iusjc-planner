# Builder stage for Angular application
FROM node:20-alpine AS builder

WORKDIR /app
COPY web/package*.json ./
RUN npm ci

COPY web/ ./
# Build production bundle using the Angular CLI configuration
RUN npm run build -- --configuration production && \
    mkdir -p /app/dist/webapp && \
    if [ -d "/app/dist/sakai-ng/browser" ]; then mv /app/dist/sakai-ng/browser/* /app/dist/webapp/; \
    elif [ -d "/app/dist/sakai-ng" ]; then mv /app/dist/sakai-ng/* /app/dist/webapp/; fi

# Production environment
FROM nginx:alpine

# Copy unified webapp output
COPY --from=builder /app/dist/webapp /usr/share/nginx/html

# Add custom Nginx configuration to route all requests to index.html (SPA routing)
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root   /usr/share/nginx/html; \
    index  index.html index.htm; \
    location / { \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://iusj-gateway-service:8080/api/; \
        proxy_set_header Host $http_host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header Authorization $http_authorization; \
        proxy_pass_header Authorization; \
    } \
    location /auth/ { \
        proxy_pass http://iusj-gateway-service:8080/auth/; \
        proxy_set_header Host $http_host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header Authorization $http_authorization; \
        proxy_pass_header Authorization; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]