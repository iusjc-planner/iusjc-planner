# Stratégie : les JARs sont pré-buildés localement via build-and-deploy.ps1
# Docker ne fait que les copier dans l'image runtime — aucun accès réseau requis.

FROM eclipse-temurin:17-jre
WORKDIR /app

ARG SERVICE_NAME
ENV SERVICE_NAME=${SERVICE_NAME}

# Spring Boot génère deux JARs : app.jar et app-plain.jar
# On copie uniquement le JAR exécutable (celui qui n'est pas -plain)
COPY ${SERVICE_NAME}/target/*[!plain].jar app.jar

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
